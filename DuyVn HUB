-- SERVER HOP ĐÚNG 1 NGƯỜI
local function HopServer()
    Hop.Text = "🔎 ĐANG TÌM..."
    Status.Text = "🔎 Tìm server có đúng 1 người..."

    local success, result = pcall(function()
        return HttpService:JSONDecode(
            game:HttpGet(
                "https://games.roblox.com/v1/games/"
                ..PlaceId..
                "/servers/Public?sortOrder=Asc&limit=100"
            )
        )
    end)

    if not success or not result or not result.data then
        Hop.Text = "❌ LỖI"
        Status.Text = "Không lấy được server"
        task.wait(2)
        Hop.Text = "👤 HOP SERVER 1 NGƯỜI"
        Status.Text = "⚡ Sẵn sàng"
        return
    end

    local list = {}

    for _,server in ipairs(result.data) do
        if server.id ~= game.JobId
        and server.playing == 1
        and server.playing < server.maxPlayers then
            table.insert(list,server)
        end
    end

    if #list == 0 then
        Hop.Text = "❌ KHÔNG CÓ"
        Status.Text = "Không tìm thấy server 1 người"
        task.wait(2)
        Hop.Text = "👤 HOP SERVER 1 NGƯỜI"
        Status.Text = "⚡ Sẵn sàng"
        return
    end

    local target = list[math.random(1,#list)]

    Hop.Text = "🚀 ĐANG HOP..."
    Status.Text = "🚀 Đang vào server 1 người"

    TeleportService:TeleportToPlaceInstance(
        PlaceId,
        target.id,
        LP
    )
end

Hop.MouseButton1Click:Connect(HopServer)

-- ULTRA LOW GRAPHICS
local Ultra = false

local function UltraLowGraphics()

    -- ÁNH SÁNG
    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 1000000
        Lighting.Brightness = 1
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
    end)

    -- TẮT TOÀN BỘ POST EFFECT
    for _,v in ipairs(Lighting:GetDescendants()) do
        if v:IsA("PostEffect")
        or v:IsA("Atmosphere")
        or v:IsA("Clouds") then
            pcall(function()
                v.Enabled = false
            end)
        end
    end

    -- GIẢM MẠNH OBJECT
    for _,v in ipairs(Workspace:GetDescendants()) do

        if v:IsA("ParticleEmitter")
        or v:IsA("Trail")
        or v:IsA("Beam")
        or v:IsA("Smoke")
        or v:IsA("Fire")
        or v:IsA("Sparkles") then

            pcall(function()
                v.Enabled = false
            end)

        elseif v:IsA("BasePart") then

            pcall(function()
                v.CastShadow = false
                v.Reflectance = 0
                v.Material = Enum.Material.Plastic
            end)

        elseif v:IsA("Decal")
        or v:IsA("Texture") then

            pcall(function()
                v.Transparency = 1
            end)

        elseif v:IsA("SurfaceAppearance") then

            pcall(function()
                v:Destroy()
            end)
        end
    end

    -- TERRAIN
    pcall(function()
        local T = Workspace.Terrain
        T.Decoration = false
        T.WaterWaveSize = 0
        T.WaterWaveSpeed = 0
        T.WaterReflectance = 0
        T.WaterTransparency = 1
    end)

    -- QUALITY THẤP NHẤT
    pcall(function()
        settings().Rendering.QualityLevel =
            Enum.QualityLevel.Level01
    end)

    -- GIẢM DETAIL MESH
    pcall(function()
        settings().Rendering.MeshPartDetailLevel =
            Enum.MeshPartDetailLevel.Level01
    end)

    Status.Text = "⛏️ ULTRA LOW GRAPHICS: ON"
end

GFX.MouseButton1Click:Connect(function()
    Ultra = not Ultra

    if Ultra then
        GFX.Text = "⛏️ ULTRA LOW GRAPHICS: ON"
        GFX.BackgroundColor3 = Color3.fromRGB(20,230,60)
        UltraLowGraphics()
    else
        GFX.Text = "⛏️ ULTRA LOW GRAPHICS: OFF"
        GFX.BackgroundColor3 = Color3.fromRGB(50,180,60)
        Status.Text = "⚡ Đã tắt chế độ"
    end
end)

