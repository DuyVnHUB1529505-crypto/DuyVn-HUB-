local function loadServers()
    if loading then return end
    loading = true
    clearList()
    setStatus("Dang tai danh sach server...")

    task.spawn(function()
        local success, err = pcall(function()
            local cursor
            local servers = {}

            for page = 1, 10 do
                local url = "https://games.roblox.com/v1/games/"
                    .. PlaceId
                    .. "/servers/Public?sortOrder=Asc&limit=100"

                if cursor and cursor ~= "" then
                    url = url .. "&cursor="
                        .. HttpService:UrlEncode(cursor)
                end

                local response = game:HttpGet(url)
                local data = HttpService:JSONDecode(response)

                for _, server in ipairs(data.data or {}) do
                    if server.id ~= game.JobId
                        and server.playing < server.maxPlayers
                        and (not onlyOne or server.playing == 1) then
                        table.insert(servers, server)
                    end
                end

                if #servers >= 50 then break end
                cursor = data.nextPageCursor
                if not cursor or cursor == "" then break end
            end

            table.sort(servers, function(a, b)
                return a.playing < b.playing
            end)

            for _, server in ipairs(servers) do
                addServer(server)
            end

            if #servers == 0 then
                local Empty = makeLabel(List,
                    "Khong tim thay server phu hop",
                    UDim2.new(), UDim2.new(1, -10, 0, 55), 12)
                setStatus("Khong tim thay server")
            else
                setStatus("Da tai " .. #servers .. " server")
            end
        end)

        if not success then
            setStatus("Loi tai server: " .. tostring(err))
        end
        loading = false
    end)
end

Load.Activated:Connect(loadServers)

-- FIX LAG
local graphicsOn = false

local function optimize(v)
    pcall(function()
        if v:IsA("PostEffect") then
            v.Enabled = false
        elseif v:IsA("Atmosphere") then
            v:Destroy()
        elseif v:IsA("Clouds") then
            v.Enabled = false
        elseif v:IsA("ParticleEmitter")
            or v:IsA("Trail")
            or v:IsA("Beam")
            or v:IsA("Smoke")
            or v:IsA("Fire")
            or v:IsA("Sparkles") then
            v.Enabled = false
        elseif v:IsA("BasePart") then
            v.CastShadow = false
            v.Reflectance = 0
            v.Material = Enum.Material.Plastic
        elseif v:IsA("Decal") or v:IsA("Texture") then
            v.Transparency = 1
        elseif v:IsA("SurfaceAppearance") then
            v:Destroy()
        end

        if v:IsA("MeshPart") then
            v.RenderFidelity = Enum.RenderFidelity.Performance
        end
    end)
end

local function fixLag()
    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 1000000
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end)

    for _, v in ipairs(Lighting:GetDescendants()) do
        optimize(v)
    end

    for _, v in ipairs(Workspace:GetDescendants()) do
        optimize(v)
    end

    pcall(function()
        local terrain = Workspace:FindFirstChildOfClass("Terrain")
        if terrain then
            terrain.Decoration = false
            terrain.WaterWaveSize = 0
            terrain.WaterWaveSpeed = 0
            terrain.WaterReflectance = 0
            terrain.WaterTransparency = 1
        end
    end)
end

FixLag.Activated:Connect(function()
    graphicsOn = true
    fixLag()
    FixLag.Text = "⚡ FIX LAG: ON"
    setStatus("Da giam hieu ung do hoa")
end)

Workspace.DescendantAdded:Connect(function(obj)
    if graphicsOn then
        task.defer(function()
            if graphicsOn and obj.Parent then
                optimize(obj)
            end
        end)
    end
end)

